<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app fetches from a server, so it needs the INTERNET permission (added in Lab 5). It is a
         normal install-time permission: granted automatically, no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Posting a notification when the background sync finishes. On Android 13 (API 33)+ this is a
         RUNTIME permission the app must request; below 33 it is granted at install time. (Lab 7) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PostsApp"
        android:allowBackup="true"
        android:label="Posts"
        android:supportsRtl="true"
        android:theme="@style/Theme.Posts">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- We supply WorkManager's Configuration ourselves (via PostsApp, so Hilt can build workers),
             so remove WorkManager's default on-demand initializer. Provided for you. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
